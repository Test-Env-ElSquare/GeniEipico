<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore"
             path="*"
             verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\API.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">

        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT"
                               value="Production" />

          <environmentVariable name="RuntimeFeatures__EnableIdentitySeed"
                               value="false" />

          <environmentVariable name="RuntimeFeatures__EnableEipicoSync"
                               value="true" />

          <environmentVariable name="RuntimeFeatures__EnableEmsEnergySync"
                               value="true" />

          <environmentVariable name="Hosting__UseHttpsRedirection"
                               value="false" />

          <environmentVariable name="ConnectionStrings__MCPAConn"
                               value="Server=10.1.1.240;Database=GenieEipico_Test;User Id=EIPDigital;Password=EIP@Digital2023EIPICO;Trusted_Connection=False;MultipleActiveResultSets=true;Encrypt=False;TrustServerCertificate=True" />

          <environmentVariable name="ConnectionStrings__EipicoSource"
                               value="Server=10.1.1.240;Database=Eipico;User Id=EIPDigital;Password=EIP@Digital2023EIPICO;Trusted_Connection=False;MultipleActiveResultSets=true;ApplicationIntent=ReadOnly;Encrypt=False;TrustServerCertificate=True" />

          <environmentVariable name="ConnectionStrings__EmsEnergySource"
                               value="Server=10.1.1.240;Database=EMS;User Id=EIPDigital;Password=EIP@Digital2023EIPICO;Trusted_Connection=False;MultipleActiveResultSets=true;ApplicationIntent=ReadOnly;Encrypt=False;TrustServerCertificate=True" />

          <environmentVariable name="Jwt__Key"
                               value="0UEOOWOdYWwB5NkwGuxfynhmyyU0v0rQ4ngyepkW6GlghjFh+OO83asUASDaN2cfHBWbIK3tx+f1Hdt1R4xvAg==" />

        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
